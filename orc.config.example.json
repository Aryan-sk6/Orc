{
  "vaultDir": "vault",
  "adapter": "claude-agent-sdk",
  "fakeScript": "orc.fake.json",
  "planner": { "model": "claude-opus-5-5" },
  "coder": { "model": "claude-sonnet-5-5" },
  "driver": { "model": "claude-haiku-5-5" },
  "maxBudgetUsd": 20,
  "retries": { "maxPerTask": 2 },
  "installCommand": "",
  "checks": [
    { "name": "typecheck", "command": "npm run typecheck", "timeoutMs": 600000 },
    { "name": "lint", "command": "npm run lint", "timeoutMs": 600000 },
    { "name": "test", "command": "npm test", "timeoutMs": 600000 },
    { "name": "build", "command": "npm run build", "timeoutMs": 600000 }
  ]
}
